OPENROUTER_API_KEY=your_openrouter_key_here
TAVILY_API_KEY=your_tavily_key_here
MONGODB_URI=your_mongodb_connection_string_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# NOTE: The /webhook endpoint now responds immediately and sends the
# fact-check result asynchronously via Twilio REST API. This avoids
# Twilio's 15-second webhook timeout (Error 11200).

# Meta WhatsApp Cloud API (replaces Twilio once the number is wired to Meta).
# Provision a WhatsApp Business Account and app at developers.facebook.com,
# then paste the values below. No code changes needed after that.
# Register the webhook in the Meta App Dashboard as:
#   Callback URL: https://<your-host>/webhook/meta
#   Verify token: the value of META_WEBHOOK_VERIFY_TOKEN below
# Access token: create a permanent System User token (24h dev tokens stop working).
META_WHATSAPP_TOKEN=your_permanent_system_user_access_token_here
META_WHATSAPP_PHONE_NUMBER_ID=your_waba_phone_number_id_here
META_WEBHOOK_VERIFY_TOKEN=any_random_string_you_choose
META_APP_SECRET=your_meta_app_secret_here

# Telegram (get token from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=any_random_string_you_choose
PORT=3000

# Model + pipeline tuning
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_MS=25000
PIPELINE_DEADLINE_MS=25000

# Scraper (RSS -> MongoDB article index)
SCRAPE_INTERVAL_MIN=30
ARTICLE_TTL_DAYS=14
SCRAPE_SECRET=change_this_secret_for_the_scrape_endpoint

# Image input handling (analysis only, never stored or served)
MEDIA_MAX_MB=5

# Cache
CACHE_TTL_SEC=3600
CACHE_MAX_ENTRIES=300

# Rate limiting (requests per 15 minutes)
RATE_LIMIT_MAX=60
