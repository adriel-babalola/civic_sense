# Copy to .env.local and adjust. Values here are compiled into the client
# bundle, so only put non-secret values in VITE_* variables.

# Canonical site origin, used for share links and sitemap output.
VITE_SITE_URL=https://civic-sense-website.vercel.app

# CivicSense WhatsApp line (E.164). Used by every "Try on WhatsApp" CTA.
VITE_WHATSAPP_NUMBER=+2349150596819

# Feature switches. Set any to "false" to remove a surface entirely: its card,
# its navigation link and its route all stop.
# VITE_FEATURE_FACTCHECK=false
# VITE_FEATURE_POLITICIANS=false
# VITE_FEATURE_MAP=false
# VITE_FEATURE_FEED=false
# VITE_FEATURE_REPORTS=false

# Admin UI talks to the server's JWT-backed /api/admin routes. The password is
# never stored in the bundle; login exchanges credentials for a token.
