# Copy to .env.local and adjust. Every value is optional in development; the
# defaults point at a local server on port 3000.

# Absolute API origin. Leave unset in development (Vite proxies /api) and in
# production when the API is served from the same domain as the site.
# VITE_API_URL=https://api.example.com

# Canonical site origin, used for share links and sitemap output.
VITE_SITE_URL=https://civic-sense-website.vercel.app

# Feature switches. Set any to "false" to remove a surface entirely: its card,
# its navigation link and its route all stop.
# VITE_FEATURE_FACTCHECK=false
# VITE_FEATURE_POLITICIANS=false
# VITE_FEATURE_MAP=false
# VITE_FEATURE_FEED=false
# VITE_FEATURE_REPORTS=false
# VITE_FEATURE_ADMIN=false

# Admin access gate. The default is a development placeholder; services/auth.js
# refuses it outside development and prints a warning while it is in use.
VITE_ADMIN_PASSWORD=civicsense
